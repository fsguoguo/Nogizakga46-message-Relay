# 环境变量配置

# 服务器配置
NODE_ENV=development
PORT=3000

# 数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/nogi_relay

# Firebase 配置
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_PATH=./firebase-admin-key.json

# API 认证
ACCESS_TOKEN=your-secret-access-token-here

# Nogizaka46 官网配置
NOGI_WEB_URL=https://message.nogizaka46.com
NOGI_ACCESS_TOKEN=your-current-access-token
NOGI_REFRESH_TOKEN=your-refresh-token
# The browser session value used by POST /v2/update_token, when required.
NOGI_AUTH_TKN=your-auth-tkn-nogizaka46.com-value
NOGI_MONITOR_MODE=browser
NOGI_BROWSER_STATE_FILE=./nogi-browser-state.json
NOGI_ACCESS_TOKEN_STATE_FILE=./nogi-access-token.json
NOGI_BROWSER_HEADLESS=true
NOGI_BROWSER_BLOCK_MEDIA=true
NOGI_BROWSER_AUTH_WAIT_SECONDS=30
NOGI_BROWSER_SESSION_REFRESH_INTERVAL_MINUTES=30
NOGI_BROWSER_RESTART_INTERVAL_SECONDS=1800

# 日志级别
LOG_LEVEL=info
LOG_STORAGE_DIR=./logs
LOG_MAX_FILE_BYTES=26214400
LOG_RETENTION_DAYS=30

# PostgreSQL retry and keep-alive settings
DB_RETRY_ATTEMPTS=5
DB_RETRY_BASE_DELAY_MS=1000
DB_RETRY_MAX_DELAY_MS=15000
DB_CONNECTION_TIMEOUT_MS=10000
DB_POOL_MIN=1
DB_POOL_MAX=20
