<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NogiRelay" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAF8FC</item>
        <item name="android:navigationBarColor">#FAF8FC</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.NogiRelay.CallBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.NogiRelay.Call" parent="@style/Theme.NogiRelay.CallBase" />
</resources>
